# Run scripts/prepare_env.py to create fresh local secrets. Never commit .env.
APP_ENV=development
POSTGRES_PASSWORD=CHANGE_ME
RABBITMQ_USER=quickbite
RABBITMQ_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+asyncpg://quickbite:CHANGE_ME@postgres:5432/quickbite
AMQP_URL=amqp://quickbite:CHANGE_ME@rabbitmq:5672/
JWT_SECRET=CHANGE_ME_TO_AT_LEAST_32_RANDOM_CHARACTERS
JWT_ISSUER=quickbite
JWT_AUDIENCE=quickbite-client
JWT_MINUTES=30
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173
RABBITMQ_MANAGEMENT_URL=http://rabbitmq:15672
RABBITMQ_MANAGEMENT_PORT=15672
API_BIND=127.0.0.1
API_PORT=8000
WEB_BIND=127.0.0.1
WEB_PORT=8080
WEB_API_BASE_URL=http://localhost:8000
PAYMENT_DELAY_MS=500
RESTAURANT_DELAY_MS=150
DELIVERY_DELAY_MS=150
NOTIFICATION_DELAY_MS=20
RETRY_DELAYS=2,10,30
PREFETCH=8
ENABLE_DEMO_FAILURES=false
DEMO_MODE=success
CRASH_CHECKPOINT=none
CRASH_SERVICE=payment
