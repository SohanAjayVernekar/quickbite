{
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "pattern": "^[a-zA-Z0-9_-]{1,64}$",
      "title": "Event Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "event_type": {
      "maxLength": 100,
      "pattern": "^order\\.[a-z]+(?:\\.[a-z]+)*$",
      "title": "Event Type",
      "type": "string"
    },
    "order_id": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Order Id",
      "type": "string"
    },
    "order_version": {
      "minimum": 1,
      "title": "Order Version",
      "type": "integer"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "correlation_id": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Correlation Id",
      "type": "string"
    },
    "causation_id": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Causation Id"
    },
    "data": {
      "additionalProperties": true,
      "title": "Data",
      "type": "object"
    }
  },
  "required": [
    "event_id",
    "schema_version",
    "event_type",
    "order_id",
    "order_version",
    "occurred_at",
    "correlation_id",
    "causation_id",
    "data"
  ],
  "title": "Event",
  "type": "object"
}
